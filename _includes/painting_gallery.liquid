{% assign ig_handle = 'Yolo' %}
{% assign ig_account = site.instagram_id | default: 'yoloytang.art' %}
{% assign ig_url = 'https://instagram.com/' | append: ig_account %}
{% assign ig_youtube = 'https://www.youtube.com/@yoloytang-art' %}
{% assign ig_x = 'https://x.com/yoloytang_art' %}
{% assign ig_pixiv = 'https://pixiv.me/yoloytang' %}
{% assign ig_avatar = '' %}
{% for file in site.static_files %}
  {% assign avatar_path = file.path | downcase %}
  {% if avatar_path contains '/assets/img/website/' %}
    {% if avatar_path contains '.jpg'
      or avatar_path contains '.jpeg'
      or avatar_path contains '.png'
      or avatar_path contains '.webp'
      or avatar_path contains '.gif'
    %}
      {% if ig_avatar == '' %}
        {% assign ig_avatar = file.path | relative_url %}
      {% endif %}
    {% endif %}
  {% endif %}
{% endfor %}

{% assign all_tags = '' | split: '' %}
{% for painting in site.data.paintings %}
  {% if painting.tags %}
    {% assign all_tags = all_tags | concat: painting.tags %}
  {% endif %}
{% endfor %}
{% assign all_tags = all_tags | uniq | sort %}

{% assign default_filter = 'illustration' %}
{% comment %}
  The tag filters (.ig-filter) live in the homepage card's Gallery hint (_pages/about.md);
  the script below picks up every .ig-filter on the page.
{% endcomment %}

<div class="ig-feed" aria-label="Painting gallery">
  {% assign by_date = site.data.paintings | sort: 'date' | reverse %}
  {% assign pinned_paintings = by_date | where: 'pin', true %}
  {% assign unpinned_paintings = by_date | where_exp: 'p', 'p.pin != true' %}
  {% assign sorted_paintings = pinned_paintings | concat: unpinned_paintings %}
  {% for painting in sorted_paintings %}
    {% if painting.images %}
      {% assign images = painting.images %}
    {% else %}
      {% assign images = painting.file | split: '~~~' %}
    {% endif %}
    {% assign image_label = painting.caption | markdownify | strip_html | strip | default: images.first %}
    {% include painting_id.liquid %}
    {% assign painting_tags = painting.tags | join: '|' | downcase %}
    {% assign matches_default_filter = false %}
    {% for tag in painting.tags %}
      {% assign tag_key = tag | downcase %}
      {% if tag_key == default_filter %}
        {% assign matches_default_filter = true %}
      {% endif %}
    {% endfor %}
    {% if painting.plain_embed %}
      {% assign x_id = '' %}
      {% assign embed_src = images.first %}
      {% if embed_src contains '/status/' %}
        {% if embed_src contains 'x.com/' or embed_src contains 'twitter.com/' %}
          {% assign x_id = embed_src | split: '/status/' | last | split: '?' | first | split: '/' | first %}
        {% endif %}
      {% endif %}
      {% if x_id == '' and painting.x_url contains '/status/' %}
        {% assign x_id = painting.x_url | split: '/status/' | last | split: '?' | first | split: '/' | first %}
      {% endif %}
      <article
        id="{{ painting_id }}"
        class="gallery-plain-embed"
        data-tags="{{ painting_tags }}"
        {% unless matches_default_filter %}
          style="display: none"
        {% endunless %}
      >
        {% if x_id != '' %}
          <div class="gallery-x-embed">
            <iframe
              src="https://platform.twitter.com/embed/Tweet.html?id={{ x_id }}&amp;dnt=true"
              title="X post"
              loading="lazy"
              frameborder="0"
              allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>
        {% endif %}
        {% if painting.tags %}
          <div class="gallery-plain-tags">
            {% for tag in painting.tags %}
              <button type="button" class="ig-tag" data-ig-filter="{{ tag | downcase }}">#{{ tag }}</button>
            {% endfor %}
          </div>
        {% endif %}
      </article>
    {% else %}
      <article
        id="{{ painting_id }}"
        class="ig-post"
        data-tags="{{ painting_tags }}"
        {% unless matches_default_filter %}
          style="display: none"
        {% endunless %}
      >
        <header class="ig-post-header">
          <button type="button" class="ig-avatar-button" aria-label="Show profile photo">
            <img class="ig-avatar" src="{{ ig_avatar }}" alt="{{ ig_handle }}" loading="lazy">
          </button>
          <div class="ig-post-meta">
            <span class="ig-username-row">
              <a class="ig-username" href="{{ ig_url }}" target="_blank" rel="noopener noreferrer">{{ ig_handle }}</a>
              <span class="ig-pronouns">she/her/hers</span>
            </span>
            {% if painting.location -%}
              <span class="ig-location">{{ painting.location }}</span>
            {%- endif %}
          </div>
          {% if painting.pin %}
            <span class="ig-pinned" title="Pinned" aria-label="Pinned">
              <svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor">
                <path d="M4.146.146A.5.5 0 0 1 4.5 0h7a.5.5 0 0 1 .354.854L10.207 2.5l.646 2.583L13.5 7.5a.5.5 0 0 1-.354.854H8.5v5.5L8 15l-.5-.646V8.354H2.854A.5.5 0 0 1 2.5 7.5l2.647-2.417L5.793 2.5 4.146.854A.5.5 0 0 1 4.146.146z"/>
              </svg>
            </span>
          {% endif %}
          <a class="ig-more" href="{{ ig_url }}" target="_blank" rel="noopener noreferrer" aria-label="Open Instagram">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
              <circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/>
            </svg>
          </a>
        </header>

        <div class="ig-carousel{% if images.size > 1 %} is-multi{% endif %}">
          <div class="ig-carousel-track">
            {% for img in images %}
              {% assign yt_id = '' %}
              {% assign ig_code = '' %}
              {% assign ig_kind = 'p' %}
              {% if img contains 'youtu.be/' %}
                {% assign yt_id = img | split: 'youtu.be/' | last | split: '?' | first | split: '&' | first %}
              {% elsif img contains 'youtube.com/watch?v=' %}
                {% assign yt_id = img | split: 'watch?v=' | last | split: '&' | first %}
              {% elsif img contains 'youtube.com/shorts/' %}
                {% assign yt_id = img | split: '/shorts/' | last | split: '?' | first | split: '&' | first %}
              {% elsif img contains 'youtube.com/embed/' %}
                {% assign yt_id = img | split: '/embed/' | last | split: '?' | first | split: '&' | first %}
              {% elsif img contains 'instagram.com/reel/' %}
                {% assign ig_code = img | split: '/reel/' | last | split: '?' | first | split: '/' | first %}
                {% assign ig_kind = 'reel' %}
              {% elsif img contains 'instagram.com/p/' %}
                {% assign ig_code = img | split: '/p/' | last | split: '?' | first | split: '/' | first %}
                {% assign ig_kind = 'p' %}
              {% endif %}
              {% if img contains '://' %}
                {% assign img_path = img %}
              {% else %}
                {% assign img_path = img | prepend: 'assets/img/painting/' | relative_url %}
              {% endif %}
              {% assign ext = img | split: '?' | first | split: '.' | last | downcase %}
              {% if painting.video_link %}
                {% assign embed_aspect = painting.aspect_ratio %}
                {% if embed_aspect == blank %}
                  {% assign embed_aspect = '1/1' %}
                {% endif %}
                {% assign embed_aspect = embed_aspect | replace: ':', '/' %}
                {% assign embed_class = '' %}
                {% case embed_aspect %}
                  {% when '9/16' %}
                    {% assign embed_class = 'is-9x16' %}
                  {% when '4/3' %}
                    {% assign embed_class = 'is-4x3' %}
                  {% when '3/4' %}
                    {% assign embed_class = 'is-3x4' %}
                  {% when '1/1' %}
                    {% assign embed_class = 'is-1x1' %}
                {% endcase %}
                <div class="ig-slide ig-slide-embed{% if embed_class != '' %} {{ embed_class }}{% endif %}">
                  <a
                    class="ig-embed ig-embed-link{% if embed_class != '' %} {{ embed_class }}{% endif %}"
                    href="{{ painting.video_link }}"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Watch video"
                  >
                    <img
                      class="ig-embed-thumb"
                      src="{{ img_path }}"
                      alt="{{ image_label | escape }}"
                      loading="lazy"
                    >
                    <span class="ig-embed-play" aria-hidden="true">
                      <svg viewBox="0 0 68 48" width="60" height="42">
                        <path class="ig-embed-play-bg" d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.64 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="#f00"/><path d="M45 24 27 14v20" fill="#fff"/>
                      </svg>
                    </span>
                  </a>
                </div>
              {% elsif ig_code != '' %}
                {% assign embed_aspect = painting.aspect_ratio %}
                {% if embed_aspect == blank %}
                  {% assign embed_aspect = '9/16' %}
                {% endif %}
                {% assign embed_aspect = embed_aspect | replace: ':', '/' %}
                {% assign embed_class = '' %}
                {% case embed_aspect %}
                  {% when '9/16' %}
                    {% assign embed_class = 'is-9x16' %}
                  {% when '4/3' %}
                    {% assign embed_class = 'is-4x3' %}
                  {% when '3/4' %}
                    {% assign embed_class = 'is-3x4' %}
                  {% when '1/1' %}
                    {% assign embed_class = 'is-1x1' %}
                {% endcase %}
                <div class="ig-slide ig-slide-embed{% if embed_class != '' %} {{ embed_class }}{% endif %}">
                  <div
                    class="ig-embed ig-embed-ig{% if embed_class != '' %} {{ embed_class }}{% endif %}"
                    data-ig-code="{{ ig_code }}"
                    data-ig-kind="{{ ig_kind }}"
                  >
                    {% if painting.poster %}
                      {% assign thumb_src = painting.poster | prepend: 'assets/img/painting/' | relative_url %}
                    {% else %}
                      {% assign thumb_src = 'https://www.instagram.com/'
                        | append: ig_kind
                        | append: '/'
                        | append: ig_code
                        | append: '/media/?size=l'
                      %}
                    {% endif %}
                    <img
                      class="ig-embed-thumb"
                      src="{{ thumb_src }}"
                      alt="{{ image_label | escape }}"
                      loading="lazy"
                    >
                    <button type="button" class="ig-embed-play" aria-label="Play Instagram video">
                      <svg viewBox="0 0 68 48" width="60" height="42">
                        <path class="ig-embed-play-bg" d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.64 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="#f00"/><path d="M45 24 27 14v20" fill="#fff"/>
                      </svg>
                    </button>
                  </div>
                </div>
              {% elsif yt_id != '' %}
                {% assign embed_aspect = painting.aspect_ratio %}
                {% if embed_aspect == blank %}
                  {% if painting.vertical == true %}
                    {% assign embed_aspect = '9/16' %}
                  {% elsif img contains '/shorts/' %}
                    {% assign embed_aspect = '9/16' %}
                  {% else %}
                    {% assign embed_aspect = '16/9' %}
                  {% endif %}
                {% endif %}
                {% assign embed_aspect = embed_aspect | replace: ':', '/' %}
                {% assign embed_class = '' %}
                {% case embed_aspect %}
                  {% when '9/16' %}
                    {% assign embed_class = 'is-9x16' %}
                  {% when '4/3' %}
                    {% assign embed_class = 'is-4x3' %}
                  {% when '3/4' %}
                    {% assign embed_class = 'is-3x4' %}
                  {% when '1/1' %}
                    {% assign embed_class = 'is-1x1' %}
                {% endcase %}
                <div class="ig-slide ig-slide-embed{% if embed_class != '' %} {{ embed_class }}{% endif %}">
                  <div class="ig-embed ig-embed-yt{% if embed_class != '' %} {{ embed_class }}{% endif %}" data-yt-id="{{ yt_id }}">
                    {% if painting.poster %}
                      {% assign thumb_src = painting.poster | prepend: 'assets/img/painting/' | relative_url %}
                    {% else %}
                      {% assign thumb_src = 'https://i.ytimg.com/vi/' | append: yt_id | append: '/maxresdefault.jpg' %}
                    {% endif %}
                    <img
                      class="ig-embed-thumb"
                      src="{{ thumb_src }}"
                      alt="{{ image_label | escape }}"
                      loading="lazy"
                      {% unless painting.poster %}
                        onerror="this.onerror=null;this.src='https://i.ytimg.com/vi/{{ yt_id }}/sddefault.jpg';this.onerror=function(){this.onerror=null;this.src='https://i.ytimg.com/vi/{{ yt_id }}/hqdefault.jpg';};"
                      {% endunless %}
                    >
                    <button type="button" class="ig-embed-play" aria-label="Play video">
                      <svg viewBox="0 0 68 48" width="60" height="42">
                        <path class="ig-embed-play-bg" d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.64 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="#f00"/><path d="M45 24 27 14v20" fill="#fff"/>
                      </svg>
                    </button>
                  </div>
                </div>
              {% elsif ext == 'mp4' or ext == 'webm' or ext == 'mov' or ext == 'ogg' or ext == 'ogv' %}
                {% assign embed_aspect = painting.aspect_ratio %}
                {% if embed_aspect == blank %}
                  {% assign embed_aspect = '16/9' %}
                {% endif %}
                {% assign embed_aspect = embed_aspect | replace: ':', '/' %}
                {% assign embed_class = '' %}
                {% case embed_aspect %}
                  {% when '9/16' %}
                    {% assign embed_class = 'is-9x16' %}
                  {% when '4/3' %}
                    {% assign embed_class = 'is-4x3' %}
                  {% when '3/4' %}
                    {% assign embed_class = 'is-3x4' %}
                  {% when '1/1' %}
                    {% assign embed_class = 'is-1x1' %}
                {% endcase %}
                <div class="ig-slide ig-slide-embed{% if embed_class != '' %} {{ embed_class }}{% endif %}">
                  <div class="ig-embed ig-embed-video{% if embed_class != '' %} {{ embed_class }}{% endif %}" data-video-src="{{ img_path }}">
                    {% if painting.poster %}
                      {% assign thumb_src = painting.poster | prepend: 'assets/img/painting/' | relative_url %}
                      <img
                        class="ig-embed-thumb"
                        src="{{ thumb_src }}"
                        alt="{{ image_label | escape }}"
                        loading="lazy"
                      >
                    {% endif %}
                    <button type="button" class="ig-embed-play" aria-label="Play video">
                      <svg viewBox="0 0 68 48" width="60" height="42">
                        <path class="ig-embed-play-bg" d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.64 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="#f00"/><path d="M45 24 27 14v20" fill="#fff"/>
                      </svg>
                    </button>
                  </div>
                </div>
              {% else %}
                {% assign is_external = false %}
                {% if img contains '://' %}
                  {% assign is_external = true %}
                {% endif %}
                {% assign can_responsive = false %}
                {% if is_external == false and site.imagemagick.enabled %}
                  {% if ext == 'jpg' or ext == 'jpeg' or ext == 'png' or ext == 'tiff' %}
                    {% assign can_responsive = true %}
                  {% endif %}
                {% endif %}
                <a class="ig-slide ig-post-media" href="{{ img_path }}" data-ig-full="{{ img_path }}" aria-label="Open {{ image_label | escape }}">
                  {% if can_responsive %}
                    {% assign img_base = img_path | remove: '.jpg' | remove: '.jpeg' | remove: '.png' | remove: '.tiff' %}
                    <picture>
                      <source
                        class="responsive-img-srcset"
                        type="image/webp"
                        srcset="{% for w in site.imagemagick.widths %}{{ img_base }}-{{ w }}.webp {{ w }}w{% unless forloop.last %}, {% endunless %}{% endfor %}"
                        sizes="(min-width: 700px) 600px, 95vw"
                      >
                      <img
                        src="{{ img_path }}"
                        alt="{{ image_label | escape }}"
                        loading="lazy"
                        onerror="this.onerror=null; $('.responsive-img-srcset').remove();"
                      >
                    </picture>
                  {% else %}
                    <img src="{{ img_path }}" alt="{{ image_label | escape }}" loading="lazy">
                  {% endif %}
                </a>
              {% endif %}
            {% endfor %}
          </div>
          {% if images.size > 1 %}
            <div class="ig-carousel-count" aria-hidden="true">1/{{ images.size }}</div>
            <button type="button" class="ig-carousel-nav ig-carousel-prev" aria-label="Previous">
              <svg
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="15 18 9 12 15 6"/>
              </svg>
            </button>
            <button type="button" class="ig-carousel-nav ig-carousel-next" aria-label="Next">
              <svg
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="9 18 15 12 9 6"/>
              </svg>
            </button>
            <div class="ig-carousel-dots" aria-hidden="true">
              {% for img in images %}
                <span class="ig-dot{% if forloop.first %} is-active{% endif %}"></span>
              {% endfor %}
            </div>
          {% endif %}
        </div>

        {% assign post_x_url = painting.x_url | default: painting.x | default: ig_x %}
        {% assign post_instagram_url = painting.instagram_url | default: painting.ins_url | default: painting.ins | default: ig_url %}
        {% assign post_youtube_url = painting.youtube_url | default: painting.youtube | default: ig_youtube %}
        {% assign post_pixiv_url = painting.pixiv_url | default: ig_pixiv %}
        <div class="ig-actions">
          <div class="ig-actions-left">
            <a class="ig-icon" href="{{ post_x_url }}" target="_blank" rel="noopener noreferrer" aria-label="X">
              <i class="fa-brands fa-x-twitter" aria-hidden="true"></i>
            </a>
            <a class="ig-icon" href="{{ post_instagram_url }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <i class="fa-brands fa-instagram" aria-hidden="true"></i>
            </a>
            <a class="ig-icon" href="{{ post_youtube_url }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
              <i class="fa-brands fa-youtube" aria-hidden="true"></i>
            </a>
          </div>
          <div class="ig-actions-right">
            <a class="ig-icon" href="{{ post_pixiv_url }}" target="_blank" rel="noopener noreferrer" aria-label="Pixiv">
              <svg class="ig-pixiv" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M4.935 0A4.924 4.924 0 0 0 0 4.935v14.13A4.924 4.924 0 0 0 4.935 24h14.13A4.924 4.924 0 0 0 24 19.065V4.935A4.924 4.924 0 0 0 19.065 0zm7.81 4.547c2.181 0 4.058.676 5.399 1.847a6.118 6.118 0 0 1 2.116 4.66c.005 1.854-.88 3.476-2.257 4.563-1.375 1.092-3.225 1.697-5.258 1.697-2.314 0-4.46-.842-4.46-.842v2.718c.397.116 1.048.365.635.779H5.79c-.41-.41.19-.65.644-.779V7.666c-1.053.81-1.593 1.51-1.868 2.031.32 1.02-.284.969-.284.969l-1.09-1.73s3.868-4.39 9.553-4.39zm-.19.971c-1.423-.003-3.184.473-4.27 1.244v8.646c.988.487 2.484.832 4.26.832h.01c1.596 0 2.98-.593 3.93-1.533.952-.948 1.486-2.183 1.492-3.683-.005-1.54-.504-2.864-1.42-3.86-.918-.992-2.274-1.645-4.002-1.646Z"/>
              </svg>
            </a>
          </div>
        </div>

        {% if painting.likes %}
          <div class="ig-likes">{{ painting.likes }} likes</div>
        {% endif %}

        {% if painting.caption %}
          <div class="ig-caption">
            <a class="ig-username" href="{{ ig_url }}" target="_blank" rel="noopener noreferrer">{{ ig_handle }}</a>
            <span class="ig-caption-text">{{ painting.caption | markdownify | remove: '<p>' | remove: '</p>' | strip }}</span>
          </div>
        {% endif %}

        {% if painting.tags %}
          <div class="ig-tags">
            {% for tag in painting.tags %}
              <button type="button" class="ig-tag" data-ig-filter="{{ tag | downcase }}">#{{ tag }}</button>
            {% endfor %}
          </div>
        {% endif %}

        {% if painting.date %}
          <time class="ig-date" datetime="{{ painting.date | date: '%Y-%m-%d' }}">{{ painting.date | date: '%B %-d, %Y' }}</time>
        {% endif %}
      </article>
    {% endif %}
  {% endfor %}
</div>

<div class="ig-lightbox" id="ig-lightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Image viewer">
  <button type="button" class="ig-lightbox-close" aria-label="Close">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/>
    </svg>
  </button>
  <button type="button" class="ig-lightbox-nav ig-lightbox-prev" aria-label="Previous">
    <svg
      viewBox="0 0 24 24"
      width="26"
      height="26"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <polyline points="15 18 9 12 15 6"/>
    </svg>
  </button>
  <button type="button" class="ig-lightbox-nav ig-lightbox-next" aria-label="Next">
    <svg
      viewBox="0 0 24 24"
      width="26"
      height="26"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <polyline points="9 18 15 12 9 6"/>
    </svg>
  </button>
  <img class="ig-lightbox-img" src="" alt="">
</div>

<script>
  (function () {
    function syncGalleryAvatar() {
      var stored = '';
      try {
        stored = window.sessionStorage.getItem('navbarAvatar') || '';
      } catch (e) {
        stored = '';
      }
      if (!stored) return;
      var avatars = document.querySelectorAll('.ig-avatar');
      for (var i = 0; i < avatars.length; i++) {
        avatars[i].src = stored;
      }
    }
    syncGalleryAvatar();
    window.addEventListener('pageshow', syncGalleryAvatar);

    var buttons = document.querySelectorAll('.ig-avatar-button');
    for (var i = 0; i < buttons.length; i++) {
      buttons[i].addEventListener('click', function () {
        if (window.showProfilePhoto) {
          window.showProfilePhoto();
          window.setTimeout(syncGalleryAvatar, 0);
        }
      });
    }

    var lightbox = document.getElementById('ig-lightbox');
    if (lightbox && lightbox.parentNode !== document.body) {
      document.body.appendChild(lightbox);
    }
    var lightboxImg = lightbox ? lightbox.querySelector('.ig-lightbox-img') : null;
    var lightboxClose = lightbox ? lightbox.querySelector('.ig-lightbox-close') : null;
    var lightboxPrev = lightbox ? lightbox.querySelector('.ig-lightbox-prev') : null;
    var lightboxNext = lightbox ? lightbox.querySelector('.ig-lightbox-next') : null;
    var lightboxItems = [];
    var lightboxIndex = 0;

    function renderLightbox() {
      if (!lightboxItems.length) return;
      var item = lightboxItems[lightboxIndex];
      lightboxImg.src = item.src;
      lightboxImg.alt = item.alt || '';
      var multi = lightboxItems.length > 1;
      if (lightboxPrev) lightboxPrev.style.display = multi ? '' : 'none';
      if (lightboxNext) lightboxNext.style.display = multi ? '' : 'none';
      if (lightboxPrev) lightboxPrev.style.visibility = lightboxIndex <= 0 ? 'hidden' : 'visible';
      if (lightboxNext) lightboxNext.style.visibility = lightboxIndex >= lightboxItems.length - 1 ? 'hidden' : 'visible';
    }

    function openLightbox(items, index) {
      if (!lightbox || !lightboxImg || !items.length) return;
      lightboxItems = items;
      lightboxIndex = index || 0;
      renderLightbox();
      lightbox.classList.add('active');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (!lightbox || !lightboxImg) return;
      lightbox.classList.remove('active');
      lightbox.setAttribute('aria-hidden', 'true');
      lightboxImg.src = '';
      lightboxItems = [];
      document.body.style.overflow = '';
    }

    function stepLightbox(dir) {
      if (!lightboxItems.length) return;
      var next = lightboxIndex + dir;
      if (next < 0 || next >= lightboxItems.length) return;
      lightboxIndex = next;
      renderLightbox();
    }

    var media = document.querySelectorAll('.ig-post-media');
    for (var m = 0; m < media.length; m++) {
      media[m].addEventListener('click', function (e) {
        e.preventDefault();
        var scope = this.closest('.ig-carousel') || this;
        var slides = scope.querySelectorAll('.ig-post-media');
        var items = [];
        var startIndex = 0;
        for (var s = 0; s < slides.length; s++) {
          if (slides[s] === this) startIndex = s;
          var slideImg = slides[s].querySelector('img');
          items.push({
            src: slides[s].getAttribute('data-ig-full') || slides[s].getAttribute('href'),
            alt: slideImg ? slideImg.alt : '',
          });
        }
        openLightbox(items, startIndex);
      });
    }

    if (lightboxClose)
      lightboxClose.addEventListener('click', function (e) {
        e.stopPropagation();
        closeLightbox();
      });
    if (lightboxPrev)
      lightboxPrev.addEventListener('click', function (e) {
        e.stopPropagation();
        stepLightbox(-1);
      });
    if (lightboxNext)
      lightboxNext.addEventListener('click', function (e) {
        e.stopPropagation();
        stepLightbox(1);
      });
    if (lightboxImg)
      lightboxImg.addEventListener('click', function (e) {
        e.stopPropagation();
        if (lightboxItems.length <= 1) closeLightbox();
      });
    if (lightbox) {
      lightbox.addEventListener('click', function () {
        closeLightbox();
      });
    }
    window.addEventListener('keydown', function (e) {
      if (!lightbox || !lightbox.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      else if (e.key === 'ArrowLeft') stepLightbox(-1);
      else if (e.key === 'ArrowRight') stepLightbox(1);
    });

    if (lightbox) {
      var touchStartX = 0;
      var touchStartY = 0;
      lightbox.addEventListener(
        'touchstart',
        function (e) {
          touchStartX = e.changedTouches[0].clientX;
          touchStartY = e.changedTouches[0].clientY;
        },
        { passive: true }
      );
      lightbox.addEventListener(
        'touchend',
        function (e) {
          var dx = e.changedTouches[0].clientX - touchStartX;
          var dy = e.changedTouches[0].clientY - touchStartY;
          if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
            stepLightbox(dx < 0 ? 1 : -1);
          }
        },
        { passive: true }
      );
    }

    var filterButtons = document.querySelectorAll('.ig-filter');
    var posts = document.querySelectorAll('.ig-post, .gallery-plain-embed');

    function applyFilter(filter) {
      for (var b = 0; b < filterButtons.length; b++) {
        var isActive = filterButtons[b].getAttribute('data-ig-filter') === filter;
        filterButtons[b].classList.toggle('is-active', isActive);
        filterButtons[b].setAttribute('aria-selected', String(isActive));
      }
      for (var p = 0; p < posts.length; p++) {
        var tags = (posts[p].getAttribute('data-tags') || '').split('|');
        var show = filter === '*' || tags.indexOf(filter) !== -1;
        posts[p].style.display = show ? '' : 'none';
      }
      requestMasonryLayout();
    }

    for (var f = 0; f < filterButtons.length; f++) {
      filterButtons[f].addEventListener('click', function () {
        applyFilter(this.getAttribute('data-ig-filter'));
      });
    }

    var tagButtons = document.querySelectorAll('.ig-tag');
    for (var t = 0; t < tagButtons.length; t++) {
      tagButtons[t].addEventListener('click', function () {
        applyFilter(this.getAttribute('data-ig-filter'));
        var filters = document.querySelector('.ig-filters');
        if (filters) filters.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    }

    var ytEmbeds = document.querySelectorAll('.ig-embed-yt');
    for (var y = 0; y < ytEmbeds.length; y++) {
      ytEmbeds[y].addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        if (this.querySelector('iframe')) return;
        var id = this.getAttribute('data-yt-id');
        var iframe = document.createElement('iframe');
        iframe.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0';
        iframe.title = 'YouTube video';
        iframe.setAttribute('frameborder', '0');
        iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share');
        iframe.setAttribute('allowfullscreen', '');
        this.appendChild(iframe);
        this.classList.add('is-playing');
      });
    }

    var igEmbeds = document.querySelectorAll('.ig-embed-ig');
    for (var i = 0; i < igEmbeds.length; i++) {
      igEmbeds[i].addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        if (this.querySelector('iframe')) return;
        var code = this.getAttribute('data-ig-code');
        var kind = this.getAttribute('data-ig-kind') || 'p';
        var iframe = document.createElement('iframe');
        iframe.src = 'https://www.instagram.com/' + kind + '/' + code + '/embed';
        iframe.title = 'Instagram post';
        iframe.setAttribute('frameborder', '0');
        iframe.setAttribute('allow', 'autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share');
        iframe.setAttribute('allowfullscreen', '');
        iframe.setAttribute('scrolling', 'no');
        this.appendChild(iframe);
        this.classList.add('is-playing');
      });
    }

    var videoEmbeds = document.querySelectorAll('.ig-embed-video');
    for (var v = 0; v < videoEmbeds.length; v++) {
      videoEmbeds[v].addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var existing = this.querySelector('video');
        if (existing) {
          existing.play();
          return;
        }
        var src = this.getAttribute('data-video-src');
        var video = document.createElement('video');
        video.className = 'ig-video';
        video.src = src;
        video.controls = true;
        video.playsInline = true;
        video.setAttribute('preload', 'metadata');
        video.setAttribute('aria-label', 'Video');
        this.appendChild(video);
        this.classList.add('is-playing');
        video.play().catch(function () {});
      });
    }

    // A track rests on the slide the viewer chose, the first one until they pick another.
    // Only a sideways swipe, the arrows, a dot, a trackpad or the keyboard choose a slide;
    // any other move (a phone page scroll that starts on an image and drifts sideways, a
    // re-layout while the gallery opens or images load) is undone once the track settles.
    var carouselHolds = [];

    function holdCarousels() {
      for (var i = 0; i < carouselHolds.length; i++) carouselHolds[i]();
    }

    var holdTimer = 0;
    function holdCarouselsSoon() {
      holdCarousels();
      window.clearTimeout(holdTimer);
      holdTimer = window.setTimeout(holdCarousels, 80);
    }

    var carousels = document.querySelectorAll('.ig-carousel.is-multi');
    for (var c = 0; c < carousels.length; c++) {
      (function (carousel) {
        var track = carousel.querySelector('.ig-carousel-track');
        var dots = carousel.querySelectorAll('.ig-dot');
        var prev = carousel.querySelector('.ig-carousel-prev');
        var next = carousel.querySelector('.ig-carousel-next');
        var count = carousel.querySelector('.ig-carousel-count');
        if (!track) return;
        var slides = track.children;

        var chosen = 0;
        var steering = false;
        var fingerDown = false;
        var touchX = 0;
        var touchY = 0;
        var settleTimer = 0;
        var settleTries = 0;

        function offsetOf(i) {
          return slides[i].getBoundingClientRect().left - track.getBoundingClientRect().left;
        }

        function hold() {
          if (steering || fingerDown || !track.clientWidth || !slides[chosen]) return;
          var off = offsetOf(chosen);
          if (Math.abs(off) > 1) track.scrollLeft += off;
        }
        carouselHolds.push(hold);

        function settle() {
          if (fingerDown) return;
          if (steering) {
            var idx = Math.max(0, Math.min(slides.length - 1, currentIndex()));
            // Take the slide the browser snaps to, not one it is passing on the way.
            if (track.clientWidth && Math.abs(offsetOf(idx)) > 1 && ++settleTries < 10) {
              settleSoon(150);
              return;
            }
            settleTries = 0;
            steering = false;
            chosen = idx;
          } else {
            hold();
          }
          update();
        }

        function settleSoon(ms) {
          window.clearTimeout(settleTimer);
          settleTimer = window.setTimeout(settle, ms);
        }

        // The longer wait covers a steer that never moves the track, like an arrow at the end.
        function steer() {
          steering = true;
          settleTries = 0;
          settleSoon(400);
        }

        track.addEventListener(
          'touchstart',
          function (e) {
            fingerDown = true;
            touchX = e.touches[0].clientX;
            touchY = e.touches[0].clientY;
          },
          { passive: true }
        );
        function sideways(t) {
          var dx = Math.abs(t.clientX - touchX);
          return dx > 10 && dx > Math.abs(t.clientY - touchY);
        }
        track.addEventListener(
          'touchmove',
          function (e) {
            if (sideways(e.touches[0])) steering = true;
          },
          { passive: true }
        );
        function lift(e) {
          if (e.touches.length) return;
          if (e.changedTouches[0] && sideways(e.changedTouches[0])) steering = true;
          fingerDown = false;
          settleSoon(150);
        }
        track.addEventListener('touchend', lift, { passive: true });
        track.addEventListener('touchcancel', lift, { passive: true });
        track.addEventListener('focusin', steer);
        track.addEventListener('keydown', steer);

        function currentIndex() {
          if (!track.clientWidth) return 0;
          return Math.round(track.scrollLeft / track.clientWidth);
        }

        function update() {
          var idx = currentIndex();
          for (var d = 0; d < dots.length; d++) {
            dots[d].classList.toggle('is-active', d === idx);
          }
          if (count) count.textContent = idx + 1 + '/' + dots.length;
          if (prev) prev.style.visibility = idx <= 0 ? 'hidden' : 'visible';
          if (next) next.style.visibility = idx >= dots.length - 1 ? 'hidden' : 'visible';
        }

        function scrollToIndex(idx) {
          idx = Math.max(0, Math.min(dots.length - 1, idx));
          steer();
          track.scrollTo({ left: idx * track.clientWidth, behavior: 'smooth' });
        }

        // A trackpad swipe that starts with a little sideways motion latches onto this
        // horizontal scroller for the whole gesture, so the page stops scrolling while the
        // pointer is over the images. Mostly-vertical scrolls are handed to the page.
        track.addEventListener(
          'wheel',
          function (e) {
            if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) {
              steer();
              return;
            }
            e.preventDefault();
            window.scrollBy(0, e.deltaMode === 1 ? e.deltaY * 16 : e.deltaY);
          },
          { passive: false }
        );

        var scrollFrame = 0;
        track.addEventListener('scroll', function () {
          settleSoon(120);
          if (scrollFrame) return;
          scrollFrame = window.requestAnimationFrame(function () {
            scrollFrame = 0;
            update();
          });
        });
        if (prev)
          prev.addEventListener('click', function () {
            scrollToIndex(currentIndex() - 1);
          });
        if (next)
          next.addEventListener('click', function () {
            scrollToIndex(currentIndex() + 1);
          });
        for (var d = 0; d < dots.length; d++) {
          (function (i) {
            dots[i].addEventListener('click', function () {
              scrollToIndex(i);
            });
          })(d);
        }
        track.scrollLeft = 0;
        update();
        window.addEventListener('load', update);
      })(carousels[c]);
    }

    window.addEventListener('pageshow', holdCarouselsSoon);
    var galleryPanel = document.querySelector('[data-about-panel="gallery"]');
    if (galleryPanel && window.MutationObserver) {
      new MutationObserver(function () {
        if (!galleryPanel.hidden) holdCarouselsSoon();
      }).observe(galleryPanel, { attributes: true, attributeFilter: ['hidden'] });
    }

    var feed = document.querySelector('.ig-feed');
    var masonryGap = 24;
    var masonryTarget = 340;
    var masonryLastWidth = 0;
    var masonryFrame = 0;

    function requestMasonryLayout() {
      if (masonryFrame) return;
      masonryFrame = window.requestAnimationFrame(function () {
        masonryFrame = 0;
        layoutMasonry();
      });
    }

    applyFilter('illustration');

    // Site search (header.liquid) lands here: show the post (switching to #All if the current
    // tag hides it), scroll it into view below the docked card and flash it once there.
    window.revealGalleryPainting = function (id) {
      var target = document.getElementById(id);
      if (!feed || !target || !feed.contains(target)) return;
      if (target.style.display === 'none') applyFilter('*');
      // Lazy images above the post would shift the masonry after the scroll; load them first.
      var pending = [];
      var feedImgs = feed.querySelectorAll('img');
      for (var i = 0; i < feedImgs.length; i++) {
        feedImgs[i].loading = 'eager';
        if (!feedImgs[i].complete) {
          pending.push(
            new Promise(function (resolve) {
              feedImgs[i].addEventListener('load', resolve);
              feedImgs[i].addEventListener('error', resolve);
            })
          );
        }
      }
      var timeout = new Promise(function (resolve) {
        window.setTimeout(resolve, 1500);
      });
      Promise.race([Promise.all(pending), timeout]).then(function () {
        layoutMasonry();
        followRevealTarget(target);
      });
    };

    // The flash class comes off once it has played (2.8s, card-hit-glow in _base.scss): a post
    // hidden by a tag and shown again would otherwise replay it.
    var revealFlash = null;
    function flashPost(target) {
      if (revealFlash) {
        window.clearTimeout(revealFlash.timer);
        revealFlash.target.classList.remove('is-search-hit');
      }
      target.classList.remove('is-search-hit');
      void target.offsetWidth;
      target.classList.add('is-search-hit');
      revealFlash = {
        target: target,
        timer: window.setTimeout(function () {
          target.classList.remove('is-search-hit');
          revealFlash = null;
        }, 2800),
      };
    }

    // Late image loads re-flow the masonry, and the browser can cancel a smooth scroll while
    // the page finishes loading. So for a few seconds, whenever scrolling has come to rest
    // with the post out of place, glide to it again; any user input stops this. The post
    // flashes once the scroll has brought it there, as papers do (research.js).
    var revealFollow = null;
    var revealStopEvents = ['wheel', 'touchstart', 'keydown', 'pointerdown'];
    function stopRevealFollow() {
      if (!revealFollow) return;
      window.clearInterval(revealFollow.timer);
      revealStopEvents.forEach(function (type) {
        window.removeEventListener(type, stopRevealFollow);
      });
      revealFollow = null;
    }
    function followRevealTarget(target) {
      stopRevealFollow();
      function offset() {
        var card = document.querySelector('.about-prompt');
        var cardBottom = card ? (parseFloat(window.getComputedStyle(card).top) || 60) + card.offsetHeight : 60;
        return target.getBoundingClientRect().top - cardBottom - 16;
      }
      function glide() {
        window.scrollTo({ top: window.scrollY + offset(), behavior: 'smooth' });
      }
      // In place, or as near as the page scrolls (the last posts can't reach the top).
      function arrived() {
        var off = offset();
        if (Math.abs(off) <= 2) return true;
        var maxY = document.documentElement.scrollHeight - window.innerHeight;
        return off > 0 ? window.scrollY >= maxY - 1 : window.scrollY <= 0;
      }
      var flashed = false;
      function flashOnce() {
        if (flashed) return;
        flashed = true;
        flashPost(target);
      }
      var lastY = window.scrollY;
      var until = Date.now() + 4000;
      var follow = (revealFollow = {
        timer: window.setInterval(function () {
          if (Date.now() > until) {
            flashOnce();
            return stopRevealFollow();
          }
          var resting = window.scrollY === lastY;
          lastY = window.scrollY;
          if (!resting) return;
          if (arrived()) flashOnce();
          else glide();
        }, 150),
      });
      // After the keydown that may have chosen the result has finished reaching the window.
      window.setTimeout(function () {
        if (revealFollow !== follow) return;
        revealStopEvents.forEach(function (type) {
          window.addEventListener(type, stopRevealFollow, { passive: true });
        });
      }, 0);
      glide();
    }

    function layoutMasonry() {
      if (!feed) return;
      var items = [];
      var all = feed.querySelectorAll('.ig-post, .gallery-plain-embed');
      for (var i = 0; i < all.length; i++) {
        if (all[i].style.display !== 'none') items.push(all[i]);
      }
      var containerWidth = feed.clientWidth;
      if (!containerWidth) return;
      masonryLastWidth = containerWidth;
      var cols = Math.max(1, Math.floor((containerWidth + masonryGap) / (masonryTarget + masonryGap)));
      var colWidth = (containerWidth - (cols - 1) * masonryGap) / cols;
      var colHeights = [];
      for (var c = 0; c < cols; c++) colHeights.push(0);
      feed.classList.add('is-masonry');
      for (var i = 0; i < items.length; i++) {
        items[i].style.width = colWidth + 'px';
      }
      var heights = [];
      for (var i = 0; i < items.length; i++) {
        heights[i] = items[i].offsetHeight;
      }
      for (var i = 0; i < items.length; i++) {
        var item = items[i];
        var min = 0;
        for (var c = 1; c < cols; c++) {
          if (colHeights[c] < colHeights[min]) min = c;
        }
        var x = min * (colWidth + masonryGap);
        var y = colHeights[min];
        item.style.transform = 'translate(' + x + 'px,' + y + 'px)';
        colHeights[min] += heights[i] + masonryGap;
      }
      var maxH = 0;
      for (var c = 0; c < cols; c++) {
        if (colHeights[c] > maxH) maxH = colHeights[c];
      }
      feed.style.height = Math.max(0, maxH - masonryGap) + 'px';
      holdCarouselsSoon();
    }

    if (feed) {
      layoutMasonry();
      var feedImages = feed.querySelectorAll('img');
      for (var fi = 0; fi < feedImages.length; fi++) {
        if (feedImages[fi].complete) {
          if (feedImages[fi].decode) feedImages[fi].decode().then(requestMasonryLayout).catch(requestMasonryLayout);
          continue;
        }
        feedImages[fi].addEventListener('load', requestMasonryLayout);
        feedImages[fi].addEventListener('error', requestMasonryLayout);
      }
      var feedVideos = feed.querySelectorAll('video');
      for (var fv = 0; fv < feedVideos.length; fv++) {
        feedVideos[fv].addEventListener('loadedmetadata', requestMasonryLayout);
        feedVideos[fv].addEventListener('loadeddata', requestMasonryLayout);
      }
      var xIframes = feed.querySelectorAll('.gallery-x-embed iframe');
      for (var xi = 0; xi < xIframes.length; xi++) {
        xIframes[xi].addEventListener('load', function () {
          requestMasonryLayout();
          window.setTimeout(requestMasonryLayout, 250);
          window.setTimeout(requestMasonryLayout, 1000);
        });
      }

      window.addEventListener('message', function (e) {
        if (e.origin !== 'https://platform.twitter.com') return;
        var payload = e.data && e.data['twttr.embed'];
        if (!payload || payload.method !== 'twttr.private.resize' || !payload.height) return;
        var iframes = feed.querySelectorAll('.gallery-x-embed iframe');
        for (var ti = 0; ti < iframes.length; ti++) {
          if (iframes[ti].contentWindow === e.source) {
            iframes[ti].style.height = payload.height + 'px';
            requestMasonryLayout();
            break;
          }
        }
      });

      window.addEventListener('load', requestMasonryLayout);
      var resizeTimer;
      window.addEventListener('resize', function () {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(requestMasonryLayout, 120);
      });
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(requestMasonryLayout);
      }
      if (window.ResizeObserver) {
        var feedObserver = new ResizeObserver(function () {
          if (feed.clientWidth && feed.clientWidth !== masonryLastWidth) requestMasonryLayout();
        });
        feedObserver.observe(feed);

        var itemObserver = new ResizeObserver(requestMasonryLayout);
        var observedItems = feed.querySelectorAll('.ig-post, .gallery-plain-embed');
        for (var oi = 0; oi < observedItems.length; oi++) {
          itemObserver.observe(observedItems[oi]);
        }
      }
    }
  })();
</script>
